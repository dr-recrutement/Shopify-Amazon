{
  "name": "Payment",
  "type": "object",
  "properties": {
    "store_id": {
      "type": "string"
    },
    "order_id": {
      "type": "string"
    },
    "provider": {
      "type": "string",
      "enum": [
        "stripe",
        "flutterwave",
        "manual"
      ],
      "default": "manual"
    },
    "amount": {
      "type": "number"
    },
    "currency": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "succeeded",
        "failed",
        "refunded",
        "partially_refunded"
      ],
      "default": "pending"
    },
    "method": {
      "type": "string",
      "description": "card, mobile_money, bank_transfer..."
    },
    "provider_ref": {
      "type": "string",
      "description": "ID externe (payment intent, charge...)"
    },
    "customer_email": {
      "type": "string"
    },
    "raw": {
      "type": "object",
      "description": "Charge utile webhook / m\u00e9tadonn\u00e9es"
    }
  },
  "required": [
    "store_id",
    "order_id",
    "amount",
    "currency"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}