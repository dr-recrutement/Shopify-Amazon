{
  "name": "Review",
  "type": "object",
  "properties": {
    "store_id": {
      "type": "string",
      "description": "Boutique propri\u00e9taire"
    },
    "product_id": {
      "type": "string",
      "description": "Produit concern\u00e9"
    },
    "product_title": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "Note de 1 \u00e0 5"
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string",
      "description": "Contenu de l'avis"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending"
    },
    "reply": {
      "type": "string",
      "description": "R\u00e9ponse du marchand"
    }
  },
  "required": [
    "store_id",
    "customer_name",
    "rating",
    "body"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}