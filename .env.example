# Variables d'environnement frontend (à copier vers .env)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Sentry DSN (identifiant public, pas un secret) — a une valeur de repli
# codée dans src/lib/sentry.ts, donc optionnel ici sauf pour pointer vers
# un autre projet Sentry (ex: staging).
VITE_SENTRY_DSN=

# Secrets serveur (Cloudflare / Supabase Edge Functions) — jamais en dur dans le code
# Clé de chiffrement des clés API paiement vendeurs
PAYMENT_API_KEY_ENCRYPTION_SECRET=
# Clés tierces (optionnel selon intégrations)
STRIPE_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
# Flux Instagram dynamique du footer (voir functions/api/instagram-feed.ts)
IG_ACCESS_TOKEN=
IG_USER_ID=
