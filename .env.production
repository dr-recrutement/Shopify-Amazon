# Required for external static hosting (e.g. Cloudflare Pages).
# Lets `npm run build` (vite build) inject the Base44 app id into the bundle so
# the deployed app can reach the Base44 backend. The Base44 platform build sets
# VITE_BASE44_APP_ID in the process env at build time, which takes precedence.
VITE_BASE44_APP_ID=6aaf8e00382d12ca2edaacca