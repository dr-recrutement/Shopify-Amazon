{
  "name": "Article",
  "type": "object",
  "properties": {
    "store_id": {
      "type": "string",
      "description": "Boutique propri\u00e9taire"
    },
    "title": {
      "type": "string"
    },
    "handle": {
      "type": "string",
      "description": "Slug URL de l'article"
    },
    "excerpt": {
      "type": "string",
      "description": "Court r\u00e9sum\u00e9 affich\u00e9 dans les listes"
    },
    "content": {
      "type": "string",
      "description": "Contenu riche HTML"
    },
    "featured_image": {
      "type": "string",
      "description": "URL image de couverture"
    },
    "author": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published"
      ],
      "default": "draft"
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "store_id",
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}